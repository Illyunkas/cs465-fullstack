<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Travel - Travlr Getaways Website Template</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header activeTravel=true}}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>{{title}}</h1>
							<p>Explore our favorite travel trips on Travlr.</p>
							<ul id="sites">
								{{#each trips}}
								<li>
									<a href="/travel"><img src="{{image}}" alt="{{name}}"></a>
									<h2><a href="/travel">{{name}}</a></h2>
									<p>Code: {{code}}</p>
									<p>{{description}}</p>
									<p>Length: {{length}}</p>
									<p>Resort: {{resort}}</p>
									<span class="price">Per Person: {{perPerson}}</span>
									<span class="date">Start: {{start}}</span>
								</li>
								{{/each}}
							</ul>
						</div>
					</div>
			</div>
		</div>
		{{> footer activeTravel=true}}
	</div>
</body>
</html>
